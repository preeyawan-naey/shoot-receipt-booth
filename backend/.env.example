# ============================================================
# LOCAL DEV — copy เป็น .env แล้วใช้ทดสอบได้เลย
# ============================================================
PORT=3000

# ไม่ต้องใส่ PUBLIC_URL ตอน dev → server หา LAN IP ให้อัตโนมัติ
# มือถือ Wi‑Fi เดียวกัน: สแกน QR ได้
# PUBLIC_URL=http://192.168.1.148:3000

# Supabase ปิดไว้ตอนทดสอบ (เปิดตอน production เท่านั้น)
# SUPABASE_ENABLED=true

# ============================================================
# PRODUCTION — เปิดเมื่อ deploy จริง
# ============================================================
# PUBLIC_URL=https://your-app.up.railway.app
#
# SUPABASE_ENABLED=true
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_BUCKET=photos
