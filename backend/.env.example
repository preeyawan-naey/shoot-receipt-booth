# ============================================================
# LOCAL DEV — copy เป็น .env แล้วใช้ทดสอบได้เลย
# ============================================================
PORT=3000

# NODE_ENV=production บังคับ PostgreSQL + Supabase (local dev ไม่ต้องตั้ง)
# REQUIRE_DEVICE_TOKEN=true บังคับ Authorization: Bearer ทุก /api/booth/* (ยกเว้น /pair)

# Database — ไม่ใส่ DATABASE_URL = ใช้ SQLite อัตโนมัติ (backend/data/tickets.db)
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:pass@host:5432/shoot_receipt
# DATABASE_SSL=true

# Backoffice:
#   Super:  http://localhost:3000/admin/           (username: admin)
#   Booth:  http://localhost:3000/admin/the-receipt-club/  (username = booth id)
ADMIN_API_KEY=1234567890
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234567890

# Omise (PromptPay) — test keys จาก Omise Dashboard
# รองรับชื่อเดิม PUBLIC_KEY / SECRET_KEY ด้วย
OMISE_PUBLIC_KEY=pkey_test_xxx
OMISE_SECRET_KEY=skey_test_xxx

# Static QR + แอppตู่อ่าน noti ธนาคาร (หรือ MacroDroid)
# สร้าง secret ยาวๆ แล้วใส่ทั้ง server และแอpp booth จะ sync อัตโนมัติ
# BANK_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ระยะเวลารอชำระเงินต่อรอบ (ms) — default 150 วินาที
# PAYMENT_SESSION_TTL_MS=150000
# มือถือ Wi‑Fi เดียวกัน: สแกน QR ได้
# PUBLIC_URL=http://192.168.1.148:3000

# Booth profiles + payment แยกต่อ booth_id
# GET  /api/booth/settings?booth_id=the-receipt-club
# Admin → Payment → เลือก booth แล้วตั้ง QR / ราคา / mode แยกกัน
# GET  /api/admin/booth-profiles  (x-admin-key)
# PUT  /api/admin/booth-profiles/:boothId

# Supabase ปิดไว้ตอนทดสอบ (เปิดตอน production เท่านั้น)
# SUPABASE_ENABLED=true

# ============================================================
# PRODUCTION — เปิดเมื่อ deploy จริง
# ============================================================
# PUBLIC_URL=https://your-app.up.railway.app
#
# SUPABASE_ENABLED=true
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_BUCKET=photos  (legacy fallback — แต่ละ booth ใช้ bucket ตาม booth_profiles.supabase_bucket)
# Server จะสร้าง bucket ที่ขาดให้อัตโนมัติตอน start (ต้องใช้ service role key)
# หรือสร้างเองใน Supabase → Storage → New bucket (Public): the-receipt-club, snap-on-receipt
#
# ลบรูปอัตโนมัติ (cron เรียก /api/cron/cleanup-photos)
PHOTO_RETENTION_DAYS=5
# PHOTO_CLEANUP_SECRET=random-secret-for-cron
# (ไม่ใส่จะใช้ ADMIN_API_KEY แทน)
