# ============================================================
# LOCAL DEV — copy เป็น .env แล้วใช้ทดสอบได้เลย
# ============================================================
PORT=3000

# Database — ไม่ใส่ DATABASE_URL = ใช้ SQLite อัตโนมัติ (backend/data/tickets.db)
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:pass@host:5432/shoot_receipt
# DATABASE_SSL=true

# สร้างโค้ดทดสอบ: npm run tickets:generate -- 20
# Backoffice: http://localhost:3000/admin/ (ใส่ ADMIN_API_KEY ตอน login)
ADMIN_API_KEY=1234567890

# Webhook จากมือถือ Android บ้าน (MacroDroid อ่านแจ้งเตือนธนาคาร)
# Header: Authorization: Bearer <ค่านี้>
BANK_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ระยะเวลารอชำระเงินต่อรอบ (ms) — default 5 นาที
# PAYMENT_SESSION_TTL_MS=300000
# มือถือ Wi‑Fi เดียวกัน: สแกน QR ได้
# PUBLIC_URL=http://192.168.1.148:3000

# Supabase ปิดไว้ตอนทดสอบ (เปิดตอน production เท่านั้น)
# SUPABASE_ENABLED=true

# ============================================================
# PRODUCTION — เปิดเมื่อ deploy จริง
# ============================================================
# PUBLIC_URL=https://your-app.up.railway.app
#
# SUPABASE_ENABLED=true
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_BUCKET=photos
